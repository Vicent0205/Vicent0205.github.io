source 'https://rubygems.org'

gem 'jekyll'

# Minimal plugin set for stable GitHub Actions builds
group :jekyll_plugins do
    gem 'jekyll-feed'
    gem 'jekyll-scholar'
    gem 'jekyll-sitemap'
    gem 'jekyll-socials'
end

# Compatibility gems required by plugin transitive dependencies
group :other_plugins do
    gem 'observer'
end
